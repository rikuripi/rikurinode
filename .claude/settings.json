{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(//home/junc/rikuri/rikurinode/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "git push *",
      "git fetch *",
      "git pull *"
    ],
    "filesystem": {
      "denyWrite": [
        "./scripts/quality/hooks"
      ],
      "denyRead": [
        "/home/junc/rikuri/rikurinode/.env",
        "/home/junc/rikuri/rikurinode/data",
        "/run/rikuri",
        "/home/junc/.ssh",
        "/home/junc/.config/gh",
        "/home/junc/.git-credentials",
        "/home/junc/.docker",
        "/home/junc/.claude/.credentials.json",
        "/home/junc/.gnupg",
        "/home/junc/.bitcoin",
        "/home/junc/.local/share/keyrings",
        "/home/junc/.config/google-chrome",
        "/home/junc/.config/chromium",
        "/home/junc/.config/BraveSoftware",
        "/home/junc/.config/Code",
        "/home/junc/.config/Claude",
        "/home/junc/.local/share/Trash"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "index.crates.io",
        "static.crates.io"
      ]
    }
  }
}
