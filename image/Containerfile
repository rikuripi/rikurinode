# The node's operating system: Fedora IoT as a bootable container image (bootc),
# built and checked by .github/workflows/image.yml. The node never builds it.
#
# Base: Fedora IoT 45 for x86_64 (45.20261031.0), pinned by digest on
# registry.fedoraproject.org, which keeps old digests (quay.io drops them within
# days). 45 from its release (owner, 2026-11-03; plan §2). The expected release
# is checked by image/check_image_root.py (FEDORA_RELEASE in the workflows).
# Record of the move: docs/build-records/2026-11-03-fedora-45.md
# Record: docs/build-records/2026-10-12-stage1-os-image.md
FROM registry.fedoraproject.org/fedora-iot@sha256:cf93fd12bb7b65b12e80823566517d1cf10d288278050ecf7ff3521ae1a62af8

# Host configuration the node relies on; each file is asserted by the check.
COPY rootfs/ /

# bootc's own checks of a bootable image; a failure fails the build.
RUN bootc container lint
