#!/usr/bin/python3 -I
"""Clear greenboot's rollback trigger when the update it names was never applied.

Runs as ExecStartPre=- of greenboot-healthcheck.service, before greenboot reads
its trigger. greenboot arms the trigger (greenboot_next_deployment_id in
grubenv) at shutdown, before ostree applies the staged update. If applying then
fails, or the power is cut between the two, the node boots its unchanged
default deployment, and greenboot 0.16.4 takes the digest mismatch for a GRUB
fallback and rolls a healthy node back (greenboot-rs #219; reproduced in
docs/build-records/2026-10-21-greenboot-drill-parallels.md, cases 2b and 3).

Plan §4.1, D22: an update that was never applied never rolls the running image
back; an unknown cause counts against the update. So the trigger is cleared in
one state only, and every other state is left to greenboot:

  booted deployment is the default (index 0 of rpm-ostree's list) and its image
  is not the one the trigger names  ->  the update was never applied: clear.

  booted image is the one named     ->  the update is on trial: leave.
  booted deployment not the default ->  GRUB fell back, or a deployment is
                                        staged ahead of it: leave.
  anything unreadable or ambiguous  ->  unknown: leave.

greenboot names the update by its image digest (sha256:<64 hex>) when the
booted system is a container image, and by the staged ostree checksum
otherwise. Only the digest form is compared; a checksum equal to the booted
deployment's is an update on trial, and any other checksum is unknown.

It runs fixed commands by absolute path, never a shell, takes no input
from the network or a user, and logs every decision to the journal. Where
/boot is mounted read-only (bootc install's layout), it remounts /boot
writable for its one write and read-only again, as greenboot 0.16.4 does;
greenboot-healthcheck.service has PrivateMounts=yes, so the remount stays in
that unit's mount namespace (CI drill run 39713948238). A clear is
appended to RECORD (one JSON line) for the control plane, which stages the
update again (D22; not built yet). Remove when greenboot fixes #219.
Record: docs/build-records/2026-10-22-d22-unapplied-update.md
"""
from __future__ import annotations

import datetime
import json
import os
import re
import subprocess
import sys

GRUB2_EDITENV = "/usr/bin/grub2-editenv"
GRUBENV = "/boot/grub2/grubenv"
RPM_OSTREE = "/usr/bin/rpm-ostree"
MOUNT = "/usr/bin/mount"
MOUNTINFO = "/proc/self/mountinfo"
TRIGGER = "greenboot_next_deployment_id"
DIGEST = "container-image-reference-digest"
CHECKSUM = "checksum"
IMAGE_DIGEST = re.compile(r"sha256:[0-9a-f]{64}")
RECORD = "/var/lib/rikuri/update-not-applied"
TIMEOUT_S = 60


def log(message: str) -> None:
    print("rikuri-unapplied-update: " + message, flush=True)


def parse_grubenv(text: str) -> dict:
    """grub2-editenv's `list` output (or the raw block): KEY=VALUE lines."""
    env = {}
    for line in text.splitlines():
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        env[key] = value
    return env


def boot_is_readonly(mountinfo: str):
    """True or False for the top /boot mount in /proc/self/mountinfo, or None
    when /boot is not a mount point (or the table is unreadable)."""
    state = None
    for line in mountinfo.splitlines():
        fields = line.split()
        if len(fields) < 6 or fields[4] != "/boot":
            continue
        state = "ro" in fields[5].split(",")   # later lines are mounted on top
    return state


def read_mountinfo() -> str:
    try:
        with open(MOUNTINFO, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return ""


def deployments_from_json(text: str):
    """rpm-ostree status --json's deployment list, in boot order, or None."""
    try:
        doc = json.loads(text)
    except ValueError:
        return None
    if not isinstance(doc, dict) or not isinstance(doc.get("deployments"), list):
        return None
    return doc["deployments"]


def decide(trigger, deployments):
    """(action, reason): action is "clear" only when the update was never applied."""
    if not trigger:
        return "none", "no rollback trigger set"
    if not deployments:
        return "none", "unknown: no deployments listed"
    booted = []
    for index, d in enumerate(deployments):
        if not isinstance(d, dict) or not isinstance(d.get("booted"), bool):
            return "none", "unknown: deployment %d is not readable" % index
        if DIGEST in d and not isinstance(d[DIGEST], str):
            return "none", "unknown: deployment %d has no readable digest" % index
        if d["booted"]:
            booted.append(index)
    if len(booted) != 1:
        return "none", "unknown: %d deployments marked booted" % len(booted)
    index = booted[0]
    if deployments[index].get(CHECKSUM) == trigger:
        return "none", "update %s booted and is on trial; greenboot decides" % trigger
    if not IMAGE_DIGEST.fullmatch(trigger):
        return "none", "unknown: the trigger %r is not an image digest; greenboot decides" % trigger
    digest = deployments[index].get(DIGEST)
    if not digest:
        return "none", "unknown: the booted deployment has no image digest"
    if digest == trigger:
        return "none", "update %s booted and is on trial; greenboot decides" % trigger
    if index != 0:
        return "none", ("booted deployment %d is not the default (GRUB fell back, or a deployment "
                        "is staged ahead of it); greenboot decides" % index)
    return "clear", ("update %s was never applied: the default deployment %s booted unchanged"
                     % (trigger, digest))


def default_run(argv):
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=TIMEOUT_S, check=False)
    except (OSError, subprocess.SubprocessError) as e:
        return 1, "%s: %s" % (argv[0], e)
    return p.returncode, p.stdout


def default_now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def append_record(path: str, entry: dict) -> None:
    os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
    with open(path, "a", encoding="ascii") as f:
        f.write(json.dumps(entry, sort_keys=True) + "\n")


def clear_trigger(run, mountinfo) -> int:
    """Unset the trigger, with /boot writable for the write if it is mounted read-only."""
    readonly = boot_is_readonly(mountinfo())
    if readonly:
        rc, _ = run([MOUNT, "-o", "remount,rw", "/boot"])
        if rc != 0:
            log("FAILED to remount /boot writable (exit %d); greenboot will roll this healthy node back" % rc)
            return rc or 1
    try:
        rc, _ = run([GRUB2_EDITENV, GRUBENV, "unset", TRIGGER])
    finally:
        if readonly:
            back, _ = run([MOUNT, "-o", "remount,bind,ro", "/boot"])
            if back != 0:
                log("/boot left writable in greenboot's private mount namespace (remount exit %d)" % back)
    if rc != 0:
        log("FAILED to clear %s (exit %d); greenboot will roll this healthy node back" % (TRIGGER, rc))
    return rc


def main(run=default_run, record_path: str = RECORD, now=default_now, mountinfo=read_mountinfo) -> int:
    rc, text = run([GRUB2_EDITENV, GRUBENV, "list"])
    if rc != 0:
        log("cannot read %s (exit %d); greenboot decides" % (GRUBENV, rc))
        return 0
    trigger = parse_grubenv(text).get(TRIGGER, "")
    if not trigger:
        log("no rollback trigger set; nothing to do")
        return 0
    rc, text = run([RPM_OSTREE, "status", "--json"])
    deployments = deployments_from_json(text) if rc == 0 else None
    action, reason = decide(trigger, deployments)
    log(reason)
    if action != "clear":
        return 0
    if clear_trigger(run, mountinfo) != 0:
        return 1
    booted = next(d[DIGEST] for d in deployments if d.get("booted"))
    try:
        append_record(record_path, {"at": now(), "not_applied": trigger, "booted": booted, "reason": reason})
    except OSError as e:
        log("trigger cleared, but the record %s could not be written: %s" % (record_path, e))
        return 1
    log("cleared %s; the node stays on %s; recorded in %s" % (TRIGGER, booted, record_path))
    return 0


if __name__ == "__main__":
    sys.exit(main())
