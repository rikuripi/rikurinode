# mDNS only on the node's physical interfaces (PLAT-01): whenever
# systemd-resolved starts, turn its mDNS off on every link without hardware
# behind it, then read its state back. Root, which resolved lets set a link's
# mDNS, with no capability; no network but resolved's D-Bus socket and the
# netlink resolvectl uses to find a link by name. Each key appears once, as
# image/check_image_root.py requires (a closed world).
# Record: docs/build-records/2026-11-10-plat01-mdns-allow-list.md
[Unit]
Description=Rikuri Node: mDNS only on physical interfaces
After=systemd-resolved.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/rikuri/mdns-links
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=systemd-resolved.service
