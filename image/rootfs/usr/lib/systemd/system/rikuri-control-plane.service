# The control plane (B0.2): the API over HTTPS on 443 from the node's own CA,
# and on 80 only the CA certificate and a redirect. Its own user, one
# capability (to bind the two ports), its state under /var. Each key appears
# once, as image/check_image_root.py requires (a closed world).
# Its name, rikurisetup.local, is the one mDNS answers; the server certificate
# also carries the node's current LAN address, which the daemon follows.
# Records: docs/build-records/2026-11-06-5c1-control-plane-on-node.md,
# docs/build-records/2026-11-10-5c2-names-and-mdns.md
[Unit]
Description=Rikuri Node control plane
After=network.target

[Service]
Type=exec
User=rikuri-control
Group=rikuri-control
ExecStart=/usr/bin/rikuri-control-plane
Environment=RIKURI_LISTEN=0.0.0.0:443 RIKURI_HTTP_LISTEN=0.0.0.0:80 RIKURI_STATE_DIR=/var/lib/rikuri/control-plane RIKURI_NAMES=rikurisetup.local
StateDirectory=rikuri/control-plane
StateDirectoryMode=0700
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
