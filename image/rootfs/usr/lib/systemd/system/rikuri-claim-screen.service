# The claim screen on tty2 (Ctrl+Alt+F2; tty1 keeps Fedora's login): the
# node's address, the CA fingerprint, and a claim code that Enter arms. The
# control plane's user and state, no capability, no IP traffic. getty@,
# autovt@ and kmsconvt@tty2 are masked beside it: a login started on this
# console would hang it up (docs/build-records/2026-11-04-installer-kmscon.md).
# Each key appears once (image/check_image_root.py).
# Record: docs/build-records/2026-11-06-5c1-control-plane-on-node.md
[Unit]
Description=Rikuri Node claim screen on tty2
After=rikuri-control-plane.service systemd-user-sessions.service

[Service]
Type=idle
User=rikuri-control
Group=rikuri-control
ExecStart=/usr/bin/rikuri-control-plane claim-screen
Environment=RIKURI_STATE_DIR=/var/lib/rikuri/control-plane
StateDirectory=rikuri/control-plane
StateDirectoryMode=0700
UMask=0077
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
