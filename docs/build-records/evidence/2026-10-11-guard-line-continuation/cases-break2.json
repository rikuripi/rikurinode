[
{"label":"B1s cat a<bs-space>#b <bs-nl> x.sekrit","cmd":"cat a@B@ #b @B@@N@x.sekrit","want":"deny"},
{"label":"B1t cat a<bs-tab>#b <bs-nl> x.sekrit","cmd":"cat a@B@@T@#b @B@@N@x.sekrit","want":"deny"},
{"label":"B1c control: cat a <bs-nl> x.sekrit (no #)","cmd":"cat a @B@@N@x.sekrit","want":"deny"},
{"label":"B2m git -c user.name=a<bs-space>#b <bs-nl> push origin main","cmd":"git -c user.name=a@B@ #b @B@@N@push origin main","want":"ask(stable)"},
{"label":"B2s git -c user.name=a<bs-space>#b <bs-nl> status (harmless)","cmd":"git -c user.name=a@B@ #b @B@@N@status","want":"allow"},
{"label":"B3 lncli --metadata=k:a<bs-space>#b <bs-nl> sendcoins","cmd":"lncli --metadata=k:a@B@ #b @B@@N@sendcoins --addr x --amt 1","want":"ask"},
{"label":"B4 lncli --metadata=k:a<bs-;>#b <bs-nl> sendcoins","cmd":"lncli --metadata=k:a@B@;#b @B@@N@sendcoins --addr x --amt 1","want":"ask"},
{"label":"B5 lncli --metadata=k:$(true)#x <bs-nl> sendcoins","cmd":"lncli --metadata=k:$(true)#x @B@@N@sendcoins --addr x --amt 1","want":"ask"},
{"label":"B6 cat $(true)#x <bs-nl> x.sekrit","cmd":"cat $(true)#x @B@@N@x.sekrit","want":"deny"},
{"label":"B7 lncli --metadata=k:a<bs-(>#b <bs-nl> sendcoins","cmd":"lncli --metadata=k:a@B@(#b @B@@N@sendcoins --addr x --amt 1","want":"ask"},
{"label":"C1 echo $<q><bs><q><q> nl lncli sendcoins #<q>","cmd":"echo $@Q@@B@@Q@@Q@@N@lncli sendcoins --addr x --amt 1 #@Q@","want":"ask"},
{"label":"C2 true $<q><bs><q><q> nl lncli sendcoins #<q>","cmd":"true $@Q@@B@@Q@@Q@@N@lncli sendcoins --addr x --amt 1 #@Q@","want":"ask"},
{"label":"C3 true $<q><bs><q><q> nl cat x.sekrit #<q>","cmd":"true $@Q@@B@@Q@@Q@@N@cat x.sekrit #@Q@","want":"deny"},
{"label":"C4 true $<q><bs><q><q> nl git push origin main #<q>","cmd":"true $@Q@@B@@Q@@Q@@N@git push origin main #@Q@","want":"ask(stable)"},
{"label":"D1 cat a<bs><bs><bs-nl> x.sekrit (odd run joins)","cmd":"cat a@B@@B@@B@@N@x.sekrit","want":"deny"},
{"label":"D2 lncli ..x<bs><bs><bs-nl> sendcoins (odd run joins)","cmd":"lncli --metadata=k:x@B@@B@@B@@N@sendcoins --addr x --amt 1","want":"ask"},
{"label":"D3 cat a<bs><bs> nl x.sekrit (even: no join)","cmd":"cat a@B@@B@@N@x.sekrit","want":"allow ok"},
{"label":"E1 lncli <bs> CR LF sendcoins (no join in bash)","cmd":"lncli @B@@R@@N@sendcoins --addr x --amt 1","want":"allow ok"},
{"label":"F1 echo $(cat <bs-nl> x.sekrit)","cmd":"echo $(cat @B@@N@x.sekrit)","want":"deny"},
{"label":"F2 echo <bt>cat <bs-nl> x.sekrit<bt>","cmd":"echo `cat @B@@N@x.sekrit`","want":"deny"},
{"label":"F3 x=$(lncli <bs-nl> sendcoins)","cmd":"x=$(lncli @B@@N@sendcoins --addr x --amt 1)","want":"ask"},
{"label":"F4 echo dq-backtick lncli <bs-nl> sendcoins","cmd":"echo @D@`lncli @B@@N@sendcoins --addr x --amt 1`@D@","want":"ask"},
{"label":"G1 sh heredoc unquoted tag, continued lncli","cmd":"sh <<EOF@N@lncli @B@@N@sendcoins --addr x --amt 1@N@EOF","want":"ask"},
{"label":"G2 sh heredoc quoted tag, continued cat x.sekrit","cmd":"sh <<@Q@EOF@Q@@N@cat @B@@N@x.sekrit@N@EOF","want":"deny"},
{"label":"G3 heredoc body apostrophe, then git push origin main","cmd":"cat <<EOF@N@don@Q@t@N@EOF@N@git push origin main","want":"ask(stable)"},
{"label":"G4 heredoc body apostrophe, then cat x.sekrit","cmd":"cat <<EOF@N@don@Q@t@N@EOF@N@cat x.sekrit","want":"deny"},
{"label":"G5 heredoc body apostrophe, then lncli sendcoins","cmd":"cat <<EOF@N@don@Q@t@N@EOF@N@lncli sendcoins --addr x --amt 1","want":"ask"},
{"label":"H1 apostrophe in comment in $(), then cat x.sekrit","cmd":"echo $(true # it@Q@s@N@)@N@cat x.sekrit","want":"deny"},
{"label":"H2 echo dq-sq-$()-dq nl lncli sendcoins #<q>","cmd":"echo @D@$(echo @Q@@D@@Q@)@D@@N@lncli sendcoins --addr x --amt 1 #@Q@","want":"ask"},
{"label":"H2b true dq-sq-$()-dq nl cat x.sekrit #<q>","cmd":"true @D@$(echo @Q@@D@@Q@)@D@@N@cat x.sekrit #@Q@","want":"deny"},
{"label":"H5 comment ending in <bs>, then cat x.sekrit","cmd":"# note @B@@N@cat x.sekrit","want":"deny"},
{"label":"I1 <bs><dq> inside single quotes; cat x.sekrit","cmd":"echo @Q@@B@@D@@Q@; cat x.sekrit","want":"deny"},
{"label":"I3 true & git push origin main","cmd":"true & git push origin main","want":"ask(stable)"},
{"label":"I4 true & cat x.sekrit","cmd":"true & cat x.sekrit","want":"deny"},
{"label":"I6 sh -c ANSI-C string with <bs>n escape","cmd":"sh -c $@Q@lncli @B@@B@@B@nsendcoins --addr x --amt 1@Q@","want":"ask"}
]