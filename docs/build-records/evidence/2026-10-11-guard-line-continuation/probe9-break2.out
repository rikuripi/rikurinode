### B1s cat a<bs-space>#b <bs-nl> x.sekrit
    cmd='cat a\\ #b \\\nx.sekrit'
    want=deny
    p9-dev=allow  old-dev=allow  p9-stab=deny  old-stab=allow
### B1t cat a<bs-tab>#b <bs-nl> x.sekrit
    cmd='cat a\\\t#b \\\nx.sekrit'
    want=deny
    p9-dev=allow  old-dev=allow  p9-stab=deny  old-stab=allow
### B1c control: cat a <bs-nl> x.sekrit (no #)
    cmd='cat a \\\nx.sekrit'
    want=deny
    p9-dev=allow  old-dev=allow  p9-stab=deny  old-stab=allow
### B2m git -c user.name=a<bs-space>#b <bs-nl> push origin main
    cmd='git -c user.name=a\\ #b \\\npush origin main'
    want=ask(stable)
    p9-dev=allow  old-dev=ask  p9-stab=ask  old-stab=ask
### B2s git -c user.name=a<bs-space>#b <bs-nl> status (harmless)
    cmd='git -c user.name=a\\ #b \\\nstatus'
    want=allow
    p9-dev=allow  old-dev=ask  p9-stab=allow  old-stab=ask
### B3 lncli --metadata=k:a<bs-space>#b <bs-nl> sendcoins
    cmd='lncli --metadata=k:a\\ #b \\\nsendcoins --addr x --amt 1'
    want=ask
    p9-dev=ask  old-dev=ask  p9-stab=ask  old-stab=ask
