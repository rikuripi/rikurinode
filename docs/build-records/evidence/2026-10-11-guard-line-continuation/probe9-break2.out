### D1 cat a<bs><bs><bs-nl> x.sekrit (odd run joins)
    cmd='cat a\\\\\\\nx.sekrit'
    want=deny
    p9-dev=allow  old-dev=allow  p9-stab=deny  old-stab=allow
### D2 lncli ..x<bs><bs><bs-nl> sendcoins (odd run joins)
    cmd='lncli --metadata=k:x\\\\\\\nsendcoins --addr x --amt 1'
    want=ask
    p9-dev=ask  old-dev=ask  p9-stab=ask  old-stab=ask
### D3 cat a<bs><bs> nl x.sekrit (even: no join)
    cmd='cat a\\\\\nx.sekrit'
    want=allow ok
    p9-dev=allow  old-dev=allow  p9-stab=allow  old-stab=allow
### E1 lncli <bs> CR LF sendcoins (no join in bash)
    cmd='lncli \\\r\nsendcoins --addr x --amt 1'
    want=allow ok
    p9-dev=allow  old-dev=ask  p9-stab=allow  old-stab=ask
### F1 echo $(cat <bs-nl> x.sekrit)
    cmd='echo $(cat \\\nx.sekrit)'
    want=deny
    p9-dev=allow  old-dev=allow  p9-stab=deny  old-stab=allow
### F2 echo <bt>cat <bs-nl> x.sekrit<bt>
    cmd='echo `cat \\\nx.sekrit`'
    want=deny
    p9-dev=allow  old-dev=allow  p9-stab=deny  old-stab=allow
### F3 x=$(lncli <bs-nl> sendcoins)
    cmd='x=$(lncli \\\nsendcoins --addr x --amt 1)'
    want=ask
    p9-dev=ask  old-dev=ask  p9-stab=ask  old-stab=ask
### F4 echo dq-backtick lncli <bs-nl> sendcoins
    cmd='echo "`lncli \\\nsendcoins --addr x --amt 1`"'
    want=ask
    p9-dev=ask  old-dev=ask  p9-stab=ask  old-stab=ask
### G1 sh heredoc unquoted tag, continued lncli
    cmd='sh <<EOF\nlncli \\\nsendcoins --addr x --amt 1\nEOF'
    want=ask
    p9-dev=ask  old-dev=ask  p9-stab=ask  old-stab=ask
### G2 sh heredoc quoted tag, continued cat x.sekrit
    cmd="sh <<'EOF'\ncat \\\nx.sekrit\nEOF"
    want=deny
    p9-dev=allow  old-dev=allow  p9-stab=deny  old-stab=allow
### G3 heredoc body apostrophe, then git push origin main
    cmd="cat <<EOF\ndon't\nEOF\ngit push origin main"
    want=ask(stable)
    p9-dev=allow  old-dev=allow  p9-stab=allow  old-stab=allow
### G4 heredoc body apostrophe, then cat x.sekrit
    cmd="cat <<EOF\ndon't\nEOF\ncat x.sekrit"
    want=deny
    p9-dev=allow  old-dev=allow  p9-stab=ask  old-stab=ask
### G5 heredoc body apostrophe, then lncli sendcoins
    cmd="cat <<EOF\ndon't\nEOF\nlncli sendcoins --addr x --amt 1"
    want=ask
    p9-dev=ask  old-dev=allow  p9-stab=ask  old-stab=allow
### H1 apostrophe in comment in $(), then cat x.sekrit
    cmd="echo $(true # it's\n)\ncat x.sekrit"
    want=deny
    p9-dev=allow  old-dev=allow  p9-stab=deny  old-stab=ask
### H2 echo dq-sq-$()-dq nl lncli sendcoins #<q>
    cmd='echo "$(echo \'"\')"\nlncli sendcoins --addr x --amt 1 #\''
    want=ask
    p9-dev=ask  old-dev=allow  p9-stab=ask  old-stab=allow
### H2b true dq-sq-$()-dq nl cat x.sekrit #<q>
    cmd='true "$(echo \'"\')"\ncat x.sekrit #\''
    want=deny
    p9-dev=allow  old-dev=allow  p9-stab=allow  old-stab=allow
### H5 comment ending in <bs>, then cat x.sekrit
    cmd='# note \\\ncat x.sekrit'
    want=deny
    p9-dev=allow  old-dev=allow  p9-stab=deny  old-stab=deny
### I1 <bs><dq> inside single quotes; cat x.sekrit
    cmd='echo \'\\"\'; cat x.sekrit'
    want=deny
    p9-dev=allow  old-dev=allow  p9-stab=deny  old-stab=deny
### I3 true & git push origin main
    cmd='true & git push origin main'
    want=ask(stable)
    p9-dev=allow  old-dev=allow  p9-stab=allow  old-stab=allow
### I4 true & cat x.sekrit
    cmd='true & cat x.sekrit'
    want=deny
    p9-dev=allow  old-dev=allow  p9-stab=ask  old-stab=ask
### I6 sh -c ANSI-C string with <bs>n escape
    cmd="sh -c $'lncli \\\\\\nsendcoins --addr x --amt 1'"
    want=ask
    p9-dev=ask  old-dev=ask  p9-stab=ask  old-stab=ask
